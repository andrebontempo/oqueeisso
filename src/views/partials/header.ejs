<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'O Que É Isso? - Artesanato Feito à Mão' %></title>
  <!-- Meta Tags Principais -->
  <meta name="description" content="Peças exclusivas de artesanato feitas à mão pela nossa família: Bolsas & Bonecas, Crochês & Afins, e Trabalhos em Madeira. Compre online com segurança!">
  <meta name="author" content="O Que É Isso? Artesanato">
  
  <!-- Open Graph / Facebook / WhatsApp Link Preview -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://oqueeisso.com/">
  <meta property="og:title" content="O Que É Isso? - Artesanato Exclusivo Feito à Mão em Família">
  <meta property="og:description" content="Peças exclusivas de artesanato feitas à mão em família: Bolsas & Bonecas, Crochês & Afins, e Trabalhos em Madeira. Compre online com segurança!">
  <meta property="og:image" content="https://oqueeisso.com/images/hero-artesanato.jpg">
  <meta property="og:image:secure_url" content="https://oqueeisso.com/images/hero-artesanato.jpg">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:site_name" content="O Que É Isso? Artesanato">

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="https://oqueeisso.com/">
  <meta name="twitter:title" content="O Que É Isso? - Artesanato Exclusivo Feito à Mão em Família">
  <meta name="twitter:description" content="Peças exclusivas de artesanato feitas à mão em família: Bolsas & Bonecas, Crochês & Afins, e Trabalhos em Madeira. Compre online com segurança!">
  <meta name="twitter:image" content="https://oqueeisso.com/images/hero-artesanato.jpg">
  
  <!-- PWA Meta Tags & Icons -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#6B3A2A">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="O Que É Isso?">
  <link rel="apple-touch-icon" href="/images/icons/icon-192.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/icons/favicon.png">
  
  <!-- PWA Registration Script -->
  <script src="/js/pwa.js" defer></script>

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Custom Design System CSS -->
  <link rel="stylesheet" href="/css/style.css?v=2.0.0">
</head>
<body>

  <!-- Top Bar -->
  <div class="top-bar">
    <div class="top-bar-inner">
      <div>
        <span><i class="fas fa-heart"></i> <%= locals.settings && locals.settings.storeNotice ? locals.settings.storeNotice : 'Artesanato Exclusivo Feito à Mão em Família' %></span>
      </div>
      <div>
        <span><i class="fas fa-truck"></i> Frete Grátis para compras acima de <%= formatMoney(typeof freeShippingThreshold !== 'undefined' ? freeShippingThreshold : 200) %></span>
      </div>
    </div>
  </div>

  <!-- Header Navigation -->
  <header class="header-nav">
    <div class="navbar-container">
      
      <!-- Top Row Mobile / Main Header -->
      <div class="navbar-top-row">
        <!-- Brand Logo -->
        <a href="/" class="brand-logo" id="header-brand-logo">
          <div class="brand-icon">
            <i class="fas fa-hands-holding"></i>
          </div>
          <div>
            <span class="brand-name">O Que É Isso?</span>
            <span class="brand-tagline hide-mobile">Artesanato com Amor</span>
          </div>
        </a>

        <!-- User Actions & Cart -->
        <div class="nav-actions">
          
          <!-- Cart Button -->
          <a href="/carrinho" class="cart-icon-btn" id="header-cart-btn" title="Ver Carrinho">
            <i class="fas fa-shopping-bag"></i>
            <span class="cart-badge"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
          </a>

          <!-- User Profile / Login -->
          <% if (locals.user) { %>
            <div style="display: flex; align-items: center; gap: 6px;">
              <a href="/minha-conta" class="user-btn" id="header-user-btn">
                <i class="fas fa-user-circle"></i>
                <span class="user-name-text"><%= locals.user.name.split(' ')[0] %></span>
              </a>
              <% if (locals.user.role === 'admin') { %>
                <a href="/admin/dashboard" class="admin-badge-btn" title="Painel Admin">
                  <i class="fas fa-crown"></i><span class="hide-mobile"> Admin</span>
                </a>
              <% } %>
              <a href="/logout" style="color: var(--text-muted); font-size: 1rem; padding: 2px;" title="Sair">
                <i class="fas fa-sign-out-alt"></i>
              </a>
            </div>
          <% } else { %>
            <a href="/login" class="user-btn" id="header-login-btn">
              <i class="fas fa-sign-in-alt"></i>
              <span class="login-btn-text">Entrar<span class="hide-mobile"> / Cadastrar</span></span>
            </a>
          <% } %>

        </div>
      </div>

      <!-- Search Bar Row -->
      <div class="navbar-search-row">
        <form action="/busca" method="GET" class="search-form" id="header-search-form">
          <input type="text" name="q" class="search-input" placeholder="Buscar por bolsas, bonecas, crochê, tábuas..." value="<%= typeof query !== 'undefined' ? query : '' %>" required>
          <button type="submit" class="search-btn" title="Buscar">
            <i class="fas fa-search"></i>
          </button>
        </form>
      </div>

    </div>
  </header>

  <!-- Category Bar -->
  <nav class="category-bar">
    <div class="category-bar-inner">
      <a href="/" class="cat-item <%= typeof title !== 'undefined' && title && title.includes('Peças Exclusivas') ? 'active' : '' %>">
        <i class="fas fa-home"></i> Início
      </a>
      <a href="/categoria/bolsas-e-bonecas" class="cat-item <%= typeof category !== 'undefined' && category && (category.slug === 'bolsas-e-bonecas' || category.slug === 'bolsas-bonecas') ? 'active' : '' %>">
        <i class="fas fa-shopping-bag"></i> Bolsas & Bonecas
      </a>
      <a href="/categoria/croches-e-afins" class="cat-item <%= typeof category !== 'undefined' && category && (category.slug === 'croche' || category.slug === 'croches-e-afins') ? 'active' : '' %>">
        <i class="fas fa-certificate"></i> Crochês & Afins
      </a>
      <a href="/categoria/trabalhos-em-madeira" class="cat-item <%= typeof category !== 'undefined' && category && category.slug === 'trabalhos-em-madeira' ? 'active' : '' %>">
        <i class="fas fa-tree"></i> Trabalhos em Madeira
      </a>
      <a href="/contato" class="cat-item <%= typeof title !== 'undefined' && title && title.includes('Fale Conosco') ? 'active' : '' %>">
        <i class="fas fa-envelope"></i> Contato
      </a>
    </div>
  </nav>

  <main class="main-wrapper">
