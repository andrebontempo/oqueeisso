<%- include('../partials/header') %>

<div style="margin-bottom: 24px;">
  <a href="/minha-conta" style="color: var(--text-muted); font-size: 0.9rem;">
    <i class="fas fa-arrow-left"></i> Voltar para Meus Pedidos
  </a>
</div>

<div style="background: #FFF; padding: 36px; border-radius: var(--radius-lg); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); margin-bottom: 48px;">
  
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; border-bottom: 2px solid var(--bg-main); padding-bottom: 20px;">
    <div>
      <h1 style="font-size: 2rem; margin-bottom: 4px;">Pedido #<%= order.orderNumber %></h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">
        Realizado em <%= new Date(order.createdAt).toLocaleDateString('pt-BR') %> às <%= new Date(order.createdAt).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %>
      </p>
    </div>
    <div style="text-align: right;">
      <span class="status-badge status-<%= order.orderStatus.toLowerCase().replace(/\s+/g, '-') %>" style="font-size: 1rem; padding: 8px 16px;">
        Status: <%= order.orderStatus %>
      </span>
      <span style="display: block; margin-top: 6px; font-size: 0.85rem; color: var(--text-muted);">
        Pagamento: <strong><%= order.paymentStatus %></strong> (<%= order.paymentMethod.toUpperCase() %>)
      </span>
    </div>
  </div>

  <!-- Tabela de Itens -->
  <h3 style="font-size: 1.2rem; margin-bottom: 16px;">Itens Comprados</h3>
  <div class="table-responsive" style="margin-bottom: 32px;">
    <table class="table">
      <thead>
        <tr>
          <th>Item</th>
          <th>Preço Un.</th>
          <th style="text-align: center;">Qtd</th>
          <th style="text-align: right;">Total</th>
        </tr>
      </thead>
      <tbody>
        <% order.items.forEach(item => { %>
          <tr>
            <td>
              <div style="display: flex; align-items: center; gap: 12px;">
                <% if (item.image) { %>
                  <img src="<%= item.image %>" alt="<%= item.name %>" style="width: 48px; height: 48px; object-fit: cover; border-radius: 6px;">
                <% } %>
                <div>
                  <strong><%= item.name %></strong>
                  <% if (item.artisan) { %>
                    <span style="display: block; font-size: 0.78rem; color: var(--text-muted);">Feito por <%= item.artisan %></span>
                  <% } %>
                </div>
              </div>
            </td>
            <td><%= formatMoney(item.price) %></td>
            <td style="text-align: center;"><%= item.quantity %></td>
            <td style="text-align: right; font-weight: 700; color: var(--primary);"><%= formatMoney(item.price * item.quantity) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px;">
    
    <!-- Endereço de Entrega -->
    <div style="background: var(--bg-main); padding: 24px; border-radius: var(--radius-md);">
      <h4 style="font-size: 1.1rem; margin-bottom: 12px; color: var(--primary);">Endereço de Entrega</h4>
      <p style="font-weight: 700; margin-bottom: 4px;"><%= order.customerName %></p>
      <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 2px;"><%= order.shippingAddress.street %>, <%= order.shippingAddress.number %> <%= order.shippingAddress.complement %></p>
      <p style="font-size: 0.9rem; color: var(--text-muted);"><%= order.shippingAddress.neighborhood %> - <%= order.shippingAddress.city %> / <%= order.shippingAddress.state %></p>
      <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px;">CEP: <%= order.shippingAddress.zipCode %></p>
    </div>

    <!-- Totais do Pedido -->
    <div style="background: var(--bg-main); padding: 24px; border-radius: var(--radius-md); display: flex; flex-direction: column; justify-content: center;">
      <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
        <span>Subtotal</span>
        <strong><%= formatMoney(order.subtotal) %></strong>
      </div>
      <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
        <span>Frete</span>
        <strong><%= order.shippingFee === 0 ? 'GRÁTIS' : formatMoney(order.shippingFee) %></strong>
      </div>
      <div style="display: flex; justify-content: space-between; font-size: 1.4rem; font-weight: 800; color: var(--primary); border-top: 2px dashed var(--border-light); padding-top: 12px;">
        <span>Total Pago</span>
        <span><%= formatMoney(order.totalAmount) %></span>
      </div>
    </div>

  </div>

</div>

<%- include('../partials/footer') %>
