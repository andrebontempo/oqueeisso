<%- include('../partials/header') %>

<div class="auth-container">
  <div class="auth-header">
    <div style="width: 50px; height: 50px; background: var(--bg-main); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin: 0 auto 12px;">
      <i class="fas fa-key"></i>
    </div>
    <h1>Recuperar Senha</h1>
    <p style="color: var(--text-muted); font-size: 0.9rem;">Digite seu e-mail cadastrado para receber as instruções de recuperação.</p>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger" style="margin-bottom: 20px;">
      <i class="fas fa-exclamation-circle"></i> <%= error %>
    </div>
  <% } %>

  <% if (success) { %>
    <div class="alert alert-success" style="background: #e6f4ea; color: #137333; border: 1px solid #ceead6; padding: 16px; border-radius: 8px; margin-bottom: 24px; font-size: 0.95rem; line-height: 1.5;">
      <div style="display: flex; gap: 10px;">
        <i class="fas fa-check-circle" style="font-size: 1.2rem; margin-top: 2px;"></i>
        <div>
          <strong>E-mail enviado!</strong>
          <p style="margin: 6px 0 0;"><%= success %></p>
        </div>
      </div>
    </div>

    <div style="text-align: center; margin-top: 20px;">
      <a href="/login" class="btn btn-outline" style="display: inline-block; padding: 12px 24px; text-decoration: none; border-radius: 8px; font-weight: 600;">
        <i class="fas fa-arrow-left"></i> Voltar para o Login
      </a>
    </div>
  <% } else { %>
    <form action="/esqueci-senha" method="POST">
      <div class="form-group">
        <label class="form-label">E-mail Cadastrado</label>
        <input type="email" name="email" value="<%= email || '' %>" class="form-control" placeholder="seu@email.com" required autofocus>
        <small style="color: var(--text-muted); font-size: 0.8rem; display: block; margin-top: 6px;">
          Enviaremos um link seguro para você redefinir sua senha.
        </small>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 14px; margin-top: 10px;">
        <i class="fas fa-paper-plane"></i> Enviar Link de Recuperação
      </button>
    </form>

    <div style="text-align: center; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-light); font-size: 0.9rem;">
      <span style="color: var(--text-muted);">Lembrou sua senha?</span>
      <a href="/login" style="font-weight: 700; color: var(--primary); margin-left: 6px;">Voltar ao Login</a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
