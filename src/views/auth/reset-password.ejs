<%- include('../partials/header') %>

<div class="auth-container">
  <div class="auth-header">
    <div style="width: 50px; height: 50px; background: var(--bg-main); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin: 0 auto 12px;">
      <i class="fas fa-shield-alt"></i>
    </div>
    <h1>Criar Nova Senha</h1>
    <p style="color: var(--text-muted); font-size: 0.9rem;">Escolha uma nova senha de acesso para a sua conta.</p>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger" style="margin-bottom: 20px;">
      <i class="fas fa-exclamation-circle"></i> <%= error %>
    </div>
  <% } %>

  <% if (invalidToken) { %>
    <div style="text-align: center; margin-top: 24px;">
      <a href="/esqueci-senha" class="btn btn-primary" style="display: inline-block; padding: 12px 24px; text-decoration: none; border-radius: 8px; font-weight: 600;">
        <i class="fas fa-redo"></i> Solicitar Novo Link
      </a>
    </div>
  <% } else { %>
    <form action="/redefinir-senha/<%= token %>" method="POST">
      <div class="form-group">
        <label class="form-label">Nova Senha</label>
        <input type="password" name="password" minlength="6" class="form-control" placeholder="Mínimo 6 caracteres" required autofocus>
      </div>

      <div class="form-group">
        <label class="form-label">Confirmar Nova Senha</label>
        <input type="password" name="confirmPassword" minlength="6" class="form-control" placeholder="Repita a nova senha" required>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 14px; margin-top: 10px;">
        <i class="fas fa-check"></i> Salvar Nova Senha
      </button>
    </form>

    <div style="text-align: center; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-light); font-size: 0.9rem;">
      <span style="color: var(--text-muted);">Lembrou a senha antiga?</span>
      <a href="/login" style="font-weight: 700; color: var(--primary); margin-left: 6px;">Voltar ao Login</a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
