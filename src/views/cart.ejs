<%- include('partials/header') %>

<div class="cart-header-title">
  <h1 class="cart-page-h1">Seu Carrinho de Compras</h1>
  <p class="cart-page-subtitle">Confira as peças selecionadas antes de finalizar seu pedido.</p>
</div>

<% if (cartItems && cartItems.length > 0) { %>

  <!-- Progresso Frete Grátis -->
  <div class="cart-free-shipping-banner">
    <i class="fas fa-truck-fast free-shipping-icon"></i>
    <div class="free-shipping-text">
      <% const threshold = typeof freeShippingThreshold !== 'undefined' ? freeShippingThreshold : 200; %>
      <% if (subtotal >= threshold) { %>
        <strong style="color: #065F46;">Parabéns! Você ganhou Frete Grátis para todo o Brasil! 🎉</strong>
      <% } else { %>
        <span>Faltam <strong><%= formatMoney(threshold - subtotal) %></strong> em compras para ganhar <strong>Frete Grátis</strong>!</span>
      <% } %>
    </div>
  </div>

  <div class="cart-layout-grid">
    
    <!-- Lista de Itens -->
    <div class="cart-items-column">

      <!-- TABELA TRADICIONAL DESKTOP (Inalterada para Desktop) -->
      <div class="cart-table-wrapper hide-mobile-cart">
        <table class="table">
          <thead>
            <tr>
              <th>Produto</th>
              <th>Preço</th>
              <th style="text-align: center;">Qtd</th>
              <th style="text-align: right;">Total</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% cartItems.forEach(item => { %>
              <tr>
                <td>
                  <div style="display: flex; align-items: center; gap: 16px;">
                    <img src="<%= item.product.images[0] %>" alt="<%= item.product.name %>" style="width: 64px; height: 64px; object-fit: cover; border-radius: var(--radius-sm);">
                    <div>
                      <strong style="display: block; font-size: 1rem;"><%= item.product.name %></strong>
                      <span style="font-size: 0.8rem; color: var(--text-muted);">Feito por <%= item.product.artisan %></span>
                    </div>
                  </div>
                </td>
                <td><%= formatMoney(item.product.price) %></td>
                <td style="text-align: center;">
                  <form action="/carrinho/atualizar" method="POST" style="display: inline-flex; align-items: center; gap: 6px;">
                    <input type="hidden" name="productId" value="<%= item.product._id %>">
                    <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="<%= item.product.stock %>" class="form-control" style="width: 60px; text-align: center; padding: 6px;" onchange="this.form.submit()">
                  </form>
                </td>
                <td style="text-align: right; font-weight: 700; color: var(--primary);"><%= formatMoney(item.itemTotal) %></td>
                <td style="text-align: right;">
                  <a href="/carrinho/remover/<%= item.product._id %>" style="color: #991B1B; font-size: 1.1rem; padding: 6px;" title="Remover item">
                    <i class="fas fa-trash-alt"></i>
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- CARDS FLUIDOS PARA NAVEGAÇÃO EM CELULAR / MOBILE -->
      <div class="cart-mobile-list hide-desktop-cart">
        <% cartItems.forEach(item => { %>
          <div class="cart-mobile-card">
            <!-- Topo do Card: Imagem, Título, Artesão e Botão Remover -->
            <div class="cart-mobile-card-top">
              <img src="<%= item.product.images[0] %>" alt="<%= item.product.name %>" class="cart-mobile-card-img">
              <div class="cart-mobile-card-info">
                <strong class="cart-mobile-card-title"><%= item.product.name %></strong>
                <span class="cart-mobile-card-artisan">Feito por <%= item.product.artisan %></span>
                <span class="cart-mobile-card-unit-price"><%= formatMoney(item.product.price) %> cada</span>
              </div>
              <a href="/carrinho/remover/<%= item.product._id %>" class="cart-mobile-card-remove" title="Remover item">
                <i class="fas fa-trash-alt"></i>
              </a>
            </div>

            <!-- Rodapé do Card: Quantidade e Subtotal -->
            <div class="cart-mobile-card-bottom">
              <form action="/carrinho/atualizar" method="POST" class="cart-mobile-qty-form">
                <input type="hidden" name="productId" value="<%= item.product._id %>">
                <label class="cart-mobile-qty-label">Qtd:</label>
                <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="<%= item.product.stock %>" class="form-control cart-mobile-qty-input" onchange="this.form.submit()">
              </form>
              <div class="cart-mobile-card-subtotal">
                <span>Total:</span>
                <strong><%= formatMoney(item.itemTotal) %></strong>
              </div>
            </div>
          </div>
        <% }); %>
      </div>

      <div class="cart-actions-row">
        <a href="/" class="btn btn-continue-shopping cart-continue-btn">
          <i class="fas fa-arrow-left"></i> Continuar Comprando
        </a>
      </div>
    </div>

    <!-- Resumo do Pedido -->
    <div class="cart-summary-column">
      <div class="cart-summary-card">
        <h3 class="cart-summary-title">
          Resumo do Pedido
        </h3>

        <div class="cart-summary-row">
          <span style="color: var(--text-muted);">Subtotal</span>
          <strong><%= formatMoney(subtotal) %></strong>
        </div>

        <div class="cart-summary-row">
          <span style="color: var(--text-muted);">Frete</span>
          <strong><%= shippingFee === 0 ? 'GRÁTIS' : formatMoney(shippingFee) %></strong>
        </div>

        <div class="cart-summary-total-row">
          <span class="cart-total-label">Total</span>
          <span class="cart-total-value"><%= formatMoney(total) %></span>
        </div>

        <a href="/checkout" class="btn btn-primary cart-checkout-btn">
          <i class="fas fa-lock"></i> Finalizar Compra
        </a>

        <div class="cart-security-badge">
          <i class="fas fa-shield-alt" style="color: var(--secondary);"></i> Ambiente 100% Seguro
        </div>
      </div>
    </div>

  </div>

<% } else { %>
  <div class="cart-empty-state">
    <i class="fas fa-shopping-bag cart-empty-icon"></i>
    <h2 class="cart-empty-title">Seu carrinho está vazio</h2>
    <p class="cart-empty-text">Que tal dar uma olhada nas nossas peças exclusivas feitas à mão?</p>
    <a href="/" class="btn btn-primary">
      <i class="fas fa-store"></i> Ver Produtos em Destaque
    </a>
  </div>
<% } %>

<%- include('partials/footer') %>


