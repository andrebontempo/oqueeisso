<%- include('partials/header') %>

<div style="margin-bottom: 32px;">
  <h1 style="font-size: 2.2rem; margin-bottom: 6px;">Seu Carrinho de Compras</h1>
  <p style="color: var(--text-muted);">Confira as peças selecionadas antes de finalizar seu pedido.</p>
</div>

<% if (cartItems && cartItems.length > 0) { %>

  <!-- Progresso Frete Grátis -->
  <div style="background: #FFF; border: 1px solid var(--border-light); padding: 16px 24px; border-radius: var(--radius-md); margin-bottom: 32px; display: flex; align-items: center; gap: 16px;">
    <i class="fas fa-truck-fast" style="font-size: 1.6rem; color: var(--secondary);"></i>
    <div style="flex: 1;">
      <% if (subtotal >= 200) { %>
        <strong style="color: #065F46;">Parabéns! Você ganhou Frete Grátis para todo o Brasil! 🎉</strong>
      <% } else { %>
        <span>Faltam <strong><%= formatMoney(200 - subtotal) %></strong> em compras para ganhar <strong>Frete Grátis</strong>!</span>
      <% } %>
    </div>
  </div>

  <div class="cart-layout-grid">
    
    <!-- Lista de Itens -->
    <div>
      <div style="background: #FFF; border-radius: var(--radius-md); border: 1px solid var(--border-light); overflow: hidden; box-shadow: var(--shadow-sm);">
        <table class="table">
          <thead>
            <tr>
              <th>Produto</th>
              <th>Preço</th>
              <th style="text-align: center;">Qtd</th>
              <th style="text-align: right;">Total</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% cartItems.forEach(item => { %>
              <tr>
                <td>
                  <div style="display: flex; align-items: center; gap: 16px;">
                    <img src="<%= item.product.images[0] %>" alt="<%= item.product.name %>" style="width: 64px; height: 64px; object-fit: cover; border-radius: var(--radius-sm);">
                    <div>
                      <strong style="display: block; font-size: 1rem;"><%= item.product.name %></strong>
                      <span style="font-size: 0.8rem; color: var(--text-muted);">Feito por <%= item.product.artisan %></span>
                    </div>
                  </div>
                </td>
                <td><%= formatMoney(item.product.price) %></td>
                <td style="text-align: center;">
                  <form action="/carrinho/atualizar" method="POST" style="display: inline-flex; align-items: center; gap: 6px;">
                    <input type="hidden" name="productId" value="<%= item.product._id %>">
                    <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="<%= item.product.stock %>" class="form-control" style="width: 60px; text-align: center; padding: 6px;" onchange="this.form.submit()">
                  </form>
                </td>
                <td style="text-align: right; font-weight: 700; color: var(--primary);"><%= formatMoney(item.itemTotal) %></td>
                <td style="text-align: right;">
                  <a href="/carrinho/remover/<%= item.product._id %>" style="color: #991B1B; font-size: 1.1rem; padding: 6px;" title="Remover item">
                    <i class="fas fa-trash-alt"></i>
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div style="margin-top: 24px; display: flex; justify-content: space-between; align-items: center;">
        <a href="/" class="btn btn-secondary">
          <i class="fas fa-arrow-left"></i> Continuar Comprando
        </a>
      </div>
    </div>

    <!-- Resumo do Pedido -->
    <div>
      <div style="background: #FFF; padding: 28px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm);">
        <h3 style="font-size: 1.3rem; margin-bottom: 20px; border-bottom: 2px solid var(--bg-main); padding-bottom: 10px;">
          Resumo do Pedido
        </h3>

        <div style="display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 0.95rem;">
          <span style="color: var(--text-muted);">Subtotal</span>
          <strong><%= formatMoney(subtotal) %></strong>
        </div>

        <div style="display: flex; justify-content: space-between; margin-bottom: 16px; font-size: 0.95rem;">
          <span style="color: var(--text-muted);">Frete</span>
          <strong><%= shippingFee === 0 ? 'GRÁTIS' : formatMoney(shippingFee) %></strong>
        </div>

        <div style="border-top: 2px dashed var(--border-light); padding-top: 16px; margin-top: 16px; display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 24px;">
          <span style="font-size: 1.1rem; font-weight: 700;">Total</span>
          <span style="font-family: 'Outfit', sans-serif; font-size: 1.8rem; font-weight: 800; color: var(--primary);"><%= formatMoney(total) %></span>
        </div>

        <a href="/checkout" class="btn btn-primary" style="width: 100%; padding: 14px;">
          <i class="fas fa-lock"></i> Finalizar Compra
        </a>

        <div style="margin-top: 20px; text-align: center; font-size: 0.8rem; color: var(--text-light); display: flex; align-items: center; justify-content: center; gap: 6px;">
          <i class="fas fa-shield-alt" style="color: var(--secondary);"></i> Ambiente 100% Seguro
        </div>
      </div>
    </div>

  </div>

<% } else { %>
  <div style="text-align: center; padding: 72px 24px; background: #FFF; border-radius: var(--radius-lg); border: 1px solid var(--border-light);">
    <i class="fas fa-shopping-bag" style="font-size: 4rem; color: var(--border-active); margin-bottom: 20px;"></i>
    <h2 style="font-size: 1.8rem; margin-bottom: 10px;">Seu carrinho está vazio</h2>
    <p style="color: var(--text-muted); margin-bottom: 28px;">Que tal dar uma olhada nas nossas peças exclusivas feitas à mão?</p>
    <a href="/" class="btn btn-primary">
      <i class="fas fa-store"></i> Ver Produtos em Destaque
    </a>
  </div>
<% } %>

<%- include('partials/footer') %>
