<%- include('partials/header') %>

<!-- Hero Banner -->
<section class="hero-section">
  <div>
    <span class="hero-badge">
      <i class="fas fa-sparkles"></i> Peças Únicas & Artesanais
    </span>
    <h1 class="hero-title">A Arte Feita à Mão que Transforma o Seu Lar</h1>
    <p class="hero-subtitle">
      Descubra o trabalho artesanal exclusivo feito com carinho pela nossa família. Bolsas elegantes, bonecas de pano, criações aconchegantes em crochê e entalhes em madeira nobre.
    </p>
    <div class="hero-cta">
      <a href="#produtos-destaque" class="btn btn-primary">
        <i class="fas fa-shopping-bag"></i> Explorar Coleção
      </a>
      <a href="#categorias" class="btn btn-secondary">
        Ver Categorias
      </a>
    </div>
  </div>
  <div class="hero-image-box">
    <img src="/images/hero-artesanato.jpg" alt="Artesanato O Que É Isso?">
  </div>
</section>

<!-- Categorias em Destaque -->
<section id="categorias" style="margin-bottom: 56px;">
  <div class="section-header">
    <h2 class="section-title">Categorias Principais</h2>
  </div>

  <div class="category-grid">
    <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
      <% categories.forEach(cat => { %>
        <a href="/categoria/<%= cat.slug %>" class="cat-card">
          <img src="<%= cat.image %>" alt="<%= cat.name %>">
          <div class="cat-card-overlay">
            <h3 class="cat-card-title"><i class="fas <%= cat.icon || 'fa-tag' %>" style="color: var(--accent-light);"></i> <%= cat.name %></h3>
            <p class="cat-card-desc"><%= cat.description %></p>
          </div>
        </a>
      <% }); %>
    <% } else { %>
      <!-- Fallback estático na ordem exata solicitada -->
      <!-- Categoria 1: Bolsas & Bonecas -->
      <a href="/categoria/bolsas-e-bonecas" class="cat-card">
        <img src="/images/cat-bolsas-bonecas.jpg" alt="Bolsas & Bonecas">
        <div class="cat-card-overlay">
          <h3 class="cat-card-title"><i class="fas fa-shopping-bag" style="color: var(--accent-light);"></i> Bolsas & Bonecas</h3>
          <p class="cat-card-desc">Bolsas em tecido de altíssimo acabamento, niqueleiras e bonecas de pano afetivas personalizadas.</p>
        </div>
      </a>

      <!-- Categoria 2: Crochês & Afins -->
      <a href="/categoria/croches-e-afins" class="cat-card">
        <img src="/images/cat-croche.jpg" alt="Crochês & Afins">
        <div class="cat-card-overlay">
          <h3 class="cat-card-title"><i class="fas fa-certificate" style="color: var(--accent-light);"></i> Crochês & Afins</h3>
          <p class="cat-card-desc">Tapetes aconchegantes, amigurumis fofos, caminhos de mesa e artigos delicados tecidos à mão.</p>
        </div>
      </a>

      <!-- Categoria 3: Trabalhos em Madeira -->
      <a href="/categoria/trabalhos-em-madeira" class="cat-card">
        <img src="/images/cat-madeira.jpg" alt="Trabalhos em Madeira">
        <div class="cat-card-overlay">
          <h3 class="cat-card-title"><i class="fas fa-tree" style="color: var(--accent-light);"></i> Trabalhos em Madeira</h3>
          <p class="cat-card-desc">Tábuas entalhadas, caixas organizadoras, descansos de panela e peças rústicas em madeira nobre.</p>
        </div>
      </a>
    <% } %>
  </div>
</section>

<!-- Produtos em Destaque -->
<section id="produtos-destaque" style="margin-bottom: 56px;">
  <div class="section-header">
    <h2 class="section-title">Produtos em Destaque</h2>
  </div>

  <div class="products-grid">
    <% if (featuredProducts && featuredProducts.length > 0) { %>
      <% featuredProducts.forEach(product => { %>
        <div class="product-card">
          <div class="product-thumb">
            <img src="<%= product.images[0] %>" alt="<%= product.name %>" loading="lazy">
            <% if (product.featured) { %>
              <span class="product-badge">Destaque</span>
            <% } %>
            <span class="product-artisan-badge">
              <i class="fas fa-user-ninja"></i> <%= product.artisan %>
            </span>
            <% if (locals.user && locals.user.role === 'admin') { %>
              <a href="/admin/produtos/editar/<%= product._id %>" style="position: absolute; top: 12px; right: 12px; background: var(--primary); color: #FFF; width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; box-shadow: var(--shadow-sm); z-index: 10;" title="Editar Produto">
                <i class="fas fa-pencil-alt"></i>
              </a>
            <% } %>
          </div>
          <div class="product-body">
            <span class="product-category"><%= product.category ? product.category.name : 'Artesanato' %></span>
            <h3 class="product-title">
              <a href="/produto/<%= product.slug || product._id %>"><%= product.name %></a>
            </h3>
            <div class="product-price-row">
              <div class="price-box">
                <% if (product.originalPrice && product.originalPrice > product.price) { %>
                  <span class="old-price"><%= formatMoney(product.originalPrice) %></span>
                <% } %>
                <span class="current-price"><%= formatMoney(product.price) %></span>
              </div>
              <form action="/carrinho/adicionar" method="POST" class="form-add-cart-ajax">
                <input type="hidden" name="productId" value="<%= product._id %>">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="btn-add-cart" title="Adicionar ao Carrinho">
                  <i class="fas fa-shopping-cart"></i>
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div style="grid-column: 1 / -1; text-align: center; padding: 48px; background: #FFF; border-radius: 16px;">
        <p style="font-size: 1.1rem; color: var(--text-muted);">Nenhum produto cadastrado ainda. Execute o script de seed para popular os produtos iniciais!</p>
      </div>
    <% } %>
  </div>
</section>

<!-- História da Família / Por Que Comprar Conosco -->
<section class="family-section">
  <div class="family-grid">
    <div>
      <span class="family-badge">Família O Que É Isso?</span>
      <h2 class="family-title">Feito por Mãos Dedicadas</h2>
      <p class="family-desc">
        Cada produto da nossa loja carrega a história e a alma do artesanato brasileiro. Nossa família é unida pelo amor à arte feita à mão: <strong>Nara Bontempo</strong> confecciona bolsas elegantes e bonecas de pano encantadoras, <strong>Alcione Pereira</strong> dedica horas tecendo artigos delicados em crochê, e <strong>Humberto Bontempo</strong> esculpe madeiras nobres transformando tábuas brutas em peças funcionais.
      </p>
      <p class="family-desc">
        Ao comprar conosco, você apoia o trabalho autêntico e leva para casa uma peça genuína, durável e cheia de significado.
      </p>
    </div>
    <div class="family-cards-grid">
      <div class="family-card-item">
        <i class="fas fa-leaf" style="color: var(--primary);"></i>
        <h4>Materiais Nobres</h4>
        <p>Seleção cuidadosa de madeira sustentável, tecidos e fios de qualidade.</p>
      </div>
      <div class="family-card-item">
        <i class="fas fa-gem" style="color: var(--secondary);"></i>
        <h4>100% Exclusivo</h4>
        <p>Nenhuma peça é exatamente igual à outra, garantindo exclusividade.</p>
      </div>
      <div class="family-card-item">
        <i class="fas fa-box-open" style="color: var(--accent);"></i>
        <h4>Embalagem Segura</h4>
        <p>Envio rápido para todo o Brasil em caixas protegidas.</p>
      </div>
      <div class="family-card-item">
        <i class="fas fa-smile-beam" style="color: #2D6A4F;"></i>
        <h4>Atendimento Familiar</h4>
        <p>Contato direto e carinho em todas as etapas da sua compra.</p>
      </div>
    </div>
  </div>
</section>

<!-- Seção Conheça Nossos Artesãos da Família -->
<section id="artesaos" style="margin-bottom: 56px;">
  <div class="section-header">
    <h2 class="section-title">Conheça Nossos Artesãos</h2>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 28px;">
    <% if (typeof artisans !== 'undefined' && artisans && artisans.length > 0) { %>
      <% artisans.forEach(artisan => { %>
        <div style="background: #FFF; border-radius: var(--radius-md); padding: 32px 24px; border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); text-align: center; display: flex; flex-direction: column; align-items: center; transition: all var(--transition-normal);" onmouseenter="this.style.transform='translateY(-6px)'; this.style.boxShadow='var(--shadow-md)';" onmouseleave="this.style.transform='none'; this.style.boxShadow='var(--shadow-sm)';">
          <div style="width: 104px; height: 104px; border-radius: 50%; overflow: hidden; margin-bottom: 16px; border: 4px solid var(--secondary); box-shadow: var(--shadow-sm);">
            <img src="<%= artisan.avatar %>" alt="<%= artisan.name %>" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
          <span style="background: rgba(210, 105, 30, 0.1); color: var(--secondary); font-size: 0.78rem; font-weight: 700; padding: 4px 14px; border-radius: var(--radius-full); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">
            <%= artisan.role %>
          </span>
          <h3 style="font-size: 1.35rem; margin-bottom: 4px;"><%= artisan.name %></h3>
          <span style="font-size: 0.88rem; font-weight: 700; color: var(--primary); margin-bottom: 14px;">
            <i class="fas fa-magic"></i> <%= artisan.specialty ? artisan.specialty.replace(/ e /g, ' & ') : '' %>
          </span>
          <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; margin-top: auto;">
            "<%= artisan.bio %>"
          </p>
        </div>
      <% }); %>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
