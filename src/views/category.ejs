<%- include('partials/header') %>

<div style="background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%); color: #FFF; padding: 40px; border-radius: var(--radius-lg); margin-bottom: 36px; box-shadow: var(--shadow-md);">
  <div style="display: flex; align-items: center; gap: 16px;">
    <div style="width: 56px; height: 56px; background: rgba(255,255,255,0.2); backdrop-filter: blur(8px); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem;">
      <i class="fas <%= category.icon || 'fa-tag' %>"></i>
    </div>
    <div>
      <h1 style="font-size: 2.2rem; color: #FFF; margin-bottom: 4px;"><%= category.name %></h1>
      <p style="color: rgba(255,255,255,0.9); font-size: 1rem;"><%= category.description %></p>
    </div>
  </div>
</div>

<div style="display: grid; grid-template-columns: 260px 1fr; gap: 32px;">
  
  <!-- Sidebar de Filtros -->
  <aside style="background: #FFF; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-light); height: fit-content;">
    <h3 style="font-size: 1.2rem; margin-bottom: 20px; border-bottom: 2px solid var(--bg-main); padding-bottom: 10px;">
      <i class="fas fa-filter" style="color: var(--secondary);"></i> Filtrar Produtos
    </h3>

    <form action="/categoria/<%= category.slug %>" method="GET">
      <div class="form-group">
        <label class="form-label">Ordenar por</label>
        <select name="sort" class="form-control">
          <option value="recent" <%= sort === 'recent' ? 'selected' : '' %>>Mais Recentes</option>
          <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Menor Preço</option>
          <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Maior Preço</option>
          <option value="name" <%= sort === 'name' ? 'selected' : '' %>>Nome (A-Z)</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Preço Mínimo (R$)</label>
        <input type="number" name="minPrice" class="form-control" placeholder="0" value="<%= minPrice %>">
      </div>

      <div class="form-group">
        <label class="form-label">Preço Máximo (R$)</label>
        <input type="number" name="maxPrice" class="form-control" placeholder="500" value="<%= maxPrice %>">
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; margin-top: 8px;">
        Aplicar Filtros
      </button>

      <% if (minPrice || maxPrice || sort !== 'recent') { %>
        <a href="/categoria/<%= category.slug %>" style="display: block; text-align: center; margin-top: 12px; font-size: 0.85rem; color: var(--text-muted);">
          Limpar Filtros
        </a>
      <% } %>
    </form>
  </aside>

  <!-- Lista de Produtos -->
  <div>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
      <p style="color: var(--text-muted); font-size: 0.95rem;">
        Exibindo <strong><%= products.length %></strong> peça(s) de artesanato nesta categoria
      </p>
    </div>

    <% if (products && products.length > 0) { %>
      <div class="products-grid">
        <% products.forEach(product => { %>
          <div class="product-card">
            <div class="product-thumb">
              <img src="<%= product.images[0] %>" alt="<%= product.name %>" loading="lazy">
              <% if (product.featured) { %>
                <span class="product-badge">Destaque</span>
              <% } %>
              <span class="product-artisan-badge">
                <i class="fas fa-user-ninja"></i> <%= product.artisan %>
              </span>
              <% if (locals.user && locals.user.role === 'admin') { %>
                <a href="/admin/produtos/editar/<%= product._id %>" style="position: absolute; top: 12px; right: 12px; background: var(--primary); color: #FFF; width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; box-shadow: var(--shadow-sm); z-index: 10;" title="Editar Produto">
                  <i class="fas fa-pencil-alt"></i>
                </a>
              <% } %>
            </div>
            <div class="product-body">
              <span class="product-category"><%= category.name %></span>
              <h3 class="product-title">
                <a href="/produto/<%= product.slug || product._id %>"><%= product.name %></a>
              </h3>
              <div class="product-price-row">
                <div class="price-box">
                  <% if (product.originalPrice && product.originalPrice > product.price) { %>
                    <span class="old-price"><%= formatMoney(product.originalPrice) %></span>
                  <% } %>
                  <span class="current-price"><%= formatMoney(product.price) %></span>
                </div>
                <form action="/carrinho/adicionar" method="POST" class="form-add-cart-ajax">
                  <input type="hidden" name="productId" value="<%= product._id %>">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="btn-add-cart" title="Adicionar ao Carrinho">
                    <i class="fas fa-shopping-cart"></i>
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 64px 24px; background: #FFF; border-radius: var(--radius-md); border: 1px solid var(--border-light);">
        <i class="fas fa-box-open" style="font-size: 3rem; color: var(--border-active); margin-bottom: 16px;"></i>
        <h3 style="font-size: 1.4rem; margin-bottom: 8px;">Nenhum produto encontrado</h3>
        <p style="color: var(--text-muted); margin-bottom: 20px;">Não encontramos produtos com os filtros selecionados nesta categoria.</p>
        <a href="/categoria/<%= category.slug %>" class="btn btn-secondary">Ver Todos os Produtos</a>
      </div>
    <% } %>
  </div>

</div>

<%- include('partials/footer') %>
