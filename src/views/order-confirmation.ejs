<%- include('partials/header') %>

<div style="max-width: 800px; margin: 0 auto; background: #FFF; padding: 48px; border-radius: var(--radius-lg); border: 1px solid var(--border-light); box-shadow: var(--shadow-md); text-align: center; margin-bottom: 48px;">
  
  <div style="width: 80px; height: 80px; background: #D1FAE5; color: #065F46; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 24px;">
    <i class="fas fa-check"></i>
  </div>

  <h1 style="font-size: 2.4rem; color: var(--text-dark); margin-bottom: 8px;">Pedido Realizado com Sucesso!</h1>
  <p style="font-size: 1.1rem; color: var(--text-muted); margin-bottom: 24px;">
    Obrigado por escolher a <strong>O Que É Isso? Artesanato</strong>! O número do seu pedido é <strong style="color: var(--primary);">#<%= order.orderNumber %></strong>.
  </p>

  <% if (order.paymentMethod === 'pix') { %>
    <!-- Bloco de Pagamento Pix -->
    <div style="background: var(--bg-main); border: 2px dashed var(--secondary); border-radius: var(--radius-md); padding: 32px; margin-bottom: 36px; text-align: center;">
      <h3 style="font-size: 1.3rem; margin-bottom: 12px; color: var(--text-dark);">
        <i class="fab fa-pix" style="color: #32BCAD;"></i> Pague agora via Pix
      </h3>
      <p style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 20px;">
        Abra o aplicativo do seu banco, escolha a opção <strong>Pix QR Code / Copia e Cola</strong> e conclua o pagamento de <strong><%= formatMoney(order.totalAmount) %></strong>.
      </p>

      <!-- Simulador de QR Code -->
      <div style="width: 180px; height: 180px; background: #FFF; border: 2px solid var(--text-dark); border-radius: 12px; margin: 0 auto 20px; display: flex; align-items: center; justify-content: center; padding: 12px; box-shadow: var(--shadow-sm);">
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=<%= encodeURIComponent(order.pixCode) %>" alt="QR Code Pix" style="width: 100%; height: 100%;">
      </div>

      <div class="form-group" style="max-width: 500px; margin: 0 auto 16px;">
        <input type="text" id="pix-code-input" readonly value="<%= order.pixCode %>" class="form-control" style="font-size: 0.8rem; text-align: center; background: #FFF;">
      </div>

      <button onclick="copyPixCode()" class="btn btn-primary" style="padding: 10px 24px; font-size: 0.95rem;">
        <i class="fas fa-copy"></i> Copiar Código Pix (Copia e Cola)
      </button>
    </div>
  <% } else { %>
    <div class="alert alert-success" style="margin-bottom: 32px;">
      <i class="fas fa-info-circle"></i> Pagamento aprovado! Seu pedido já deu entrada no ateliê e iniciará a separação/produção.
    </div>
  <% } %>

  <!-- Resumo da Entrega -->
  <div style="text-align: left; background: #FAF7F2; padding: 24px; border-radius: var(--radius-md); margin-bottom: 32px;">
    <h3 style="font-size: 1.1rem; margin-bottom: 12px; border-bottom: 1px solid var(--border-light); padding-bottom: 8px;">
      Endereço de Entrega
    </h3>
    <p style="font-size: 0.95rem; color: var(--text-dark); margin-bottom: 4px;"><strong><%= order.customerName %></strong></p>
    <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 2px;"><%= order.shippingAddress.street %>, <%= order.shippingAddress.number %> <%= order.shippingAddress.complement %></p>
    <p style="font-size: 0.9rem; color: var(--text-muted);"><%= order.shippingAddress.neighborhood %> - <%= order.shippingAddress.city %> / <%= order.shippingAddress.state %> - CEP: <%= order.shippingAddress.zipCode %></p>
  </div>

  <div style="display: flex; justify-content: center; gap: 16px;">
    <% if (locals.user) { %>
      <a href="/minha-conta" class="btn btn-primary">
        <i class="fas fa-box"></i> Ver Meus Pedidos
      </a>
    <% } %>
    <a href="/" class="btn btn-secondary">
      <i class="fas fa-home"></i> Voltar à Loja
    </a>
  </div>

</div>

<%- include('partials/footer') %>
