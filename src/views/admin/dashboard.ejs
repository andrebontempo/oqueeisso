        <div style="flex: 1; min-width: 260px;">
          <h4 style="font-size: 1.05rem; color: var(--primary); margin-bottom: 4px;">Instalação Nativa no Celular</h4>
          <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0 0 8px 0;">O e-commerce conta com <code>manifest.json</code> e <code>sw.js</code> (Service Worker). No Android/Chrome é exibido o banner de instalação direta. No iOS/Safari são exibidas instruções de "Adicionar à Tela de Início".</p>
          <span style="font-size: 0.8rem; background: var(--secondary); color: #FFF; padding: 3px 10px; border-radius: 12px; font-weight: 700;">Modo Standalone sem barras de navegador</span>
        </div>
      </div>
    </div>

    <!-- Seção 6: Deploy & Comandos Úteis -->
    <div>
      <h3 style="font-size: 1.3rem; color: var(--primary); margin-bottom: 16px; display: flex; align-items: center; gap: 10px;">
        <i class="fas fa-terminal" style="color: var(--accent);"></i> 6. Comandos Úteis na VPS (Terminal)
      </h3>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div style="background: #F8FAFC; padding: 18px; border-radius: 10px; border: 1px solid var(--border-light);">
          <strong style="font-size: 0.95rem; color: var(--primary); display: block; margin-bottom: 6px;">
            <i class="fas fa-sync"></i> Executar Deploy Manual na VPS:
          </strong>
          <code style="background: #E2E8F0; padding: 6px 10px; border-radius: 6px; display: block; font-size: 0.85rem; color: #0F172A;">./deploy.sh</code>
        </div>

        <div style="background: #F8FAFC; padding: 18px; border-radius: 10px; border: 1px solid var(--border-light);">
          <strong style="font-size: 0.95rem; color: var(--primary); display: block; margin-bottom: 6px;">
            <i class="fas fa-seedling"></i> Executar Povoamento do Banco (Seed):
          </strong>
          <code style="background: #E2E8F0; padding: 6px 10px; border-radius: 6px; display: block; font-size: 0.85rem; color: #0F172A;">docker exec -it oqueeisso-app npm run seed</code>
        </div>

        <div style="background: #F8FAFC; padding: 18px; border-radius: 10px; border: 1px solid var(--border-light);">
          <strong style="font-size: 0.95rem; color: var(--primary); display: block; margin-bottom: 6px;">
            <i class="fas fa-scroll"></i> Ver Logs do Servidor em Tempo Real:
          </strong>
          <code style="background: #E2E8F0; padding: 6px 10px; border-radius: 6px; display: block; font-size: 0.85rem; color: #0F172A;">docker logs -f oqueeisso-app</code>
        </div>

        <div style="background: #F8FAFC; padding: 18px; border-radius: 10px; border: 1px solid var(--border-light);">
          <strong style="font-size: 0.95rem; color: var(--primary); display: block; margin-bottom: 6px;">
            <i class="fas fa-database"></i> Backup dos Dados do MongoDB:
          </strong>
          <code style="background: #E2E8F0; padding: 6px 10px; border-radius: 6px; display: block; font-size: 0.85rem; color: #0F172A;">docker exec -it oqueeisso-mongo mongodump --out /data/db/backup</code>
        </div>
      </div>
    </div>

  </div>
<% } %>

