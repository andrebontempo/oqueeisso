<%- include('../partials/header') %>

<div style="margin-bottom: 24px;">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <div>
      <h1 style="font-size: 2.2rem; margin-bottom: 4px;">Painel de Controle Admin</h1>
      <p style="color: var(--text-muted);">Central unificada de gestão do e-commerce O Que É Isso?</p>
    </div>
    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
      <a href="/admin/produtos/novo" class="btn btn-primary" style="padding: 10px 18px; font-size: 0.9rem;">
        <i class="fas fa-plus"></i> Novo Produto
      </a>
      <a href="/admin/usuarios/novo" class="btn btn-secondary" style="padding: 10px 18px; font-size: 0.9rem;">
        <i class="fas fa-user-plus"></i> Novo Cliente/User
      </a>
    </div>
  </div>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success">
    <i class="fas fa-check-circle"></i> <%= success %>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger">
    <i class="fas fa-exclamation-triangle"></i> <%= error %>
  </div>
<% } %>

<!-- Barra de Navegação em Abas (Tabs Bar) -->
<div class="admin-tabs-nav" style="display: flex; gap: 8px; border-bottom: 2px solid var(--border-light); margin-bottom: 32px; overflow-x: auto; padding-bottom: 4px;">
  <a href="/admin/dashboard?tab=overview" class="admin-tab-btn <%= activeTab === 'overview' ? 'active' : '' %>" id="tab-btn-overview">
    <i class="fas fa-chart-line"></i> Visão Geral
  </a>
  <a href="/admin/dashboard?tab=produtos" class="admin-tab-btn <%= activeTab === 'produtos' ? 'active' : '' %>" id="tab-btn-produtos">
    <i class="fas fa-boxes-stacked"></i> Produtos (<%= totalProducts %>)
  </a>
  <a href="/admin/dashboard?tab=pedidos" class="admin-tab-btn <%= activeTab === 'pedidos' ? 'active' : '' %>" id="tab-btn-pedidos">
    <i class="fas fa-truck-fast"></i> Controle de Pedidos (<%= totalOrders %>)
  </a>
  <a href="/admin/dashboard?tab=usuarios" class="admin-tab-btn <%= activeTab === 'usuarios' ? 'active' : '' %>" id="tab-btn-usuarios">
    <i class="fas fa-users"></i> Usuários & Clientes (<%= totalUsers %>)
  </a>
  <a href="/admin/dashboard?tab=artesaos" class="admin-tab-btn <%= activeTab === 'artesaos' ? 'active' : '' %>" id="tab-btn-artesaos">
    <i class="fas fa-palette"></i> Artesãos (<%= totalArtisans %>)
  </a>
  <a href="/admin/dashboard?tab=categorias" class="admin-tab-btn <%= activeTab === 'categorias' ? 'active' : '' %>" id="tab-btn-categorias">
    <i class="fas fa-tags"></i> Categorias (<%= totalCategories %>)
  </a>
  <a href="/admin/dashboard?tab=docs" class="admin-tab-btn <%= activeTab === 'docs' ? 'active' : '' %>" id="tab-btn-docs" style="background: rgba(139, 69, 19, 0.08); border-radius: 8px;">
    <i class="fas fa-book-bookmark"></i> Documentação
  </a>
</div>

<style>
  .admin-tab-btn {
    padding: 12px 20px;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-muted);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    white-space: nowrap;
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 3px solid transparent;
  }
  .admin-tab-btn:hover {
    color: var(--primary);
    background: rgba(139, 69, 19, 0.05);
  }
  .admin-tab-btn.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
    background: #FFF;
  }
</style>

<!-- =================================================================== -->
<!-- ABA 1: VISÃO GERAL (OVERVIEW) -->
<!-- =================================================================== -->
<% if (activeTab === 'overview') { %>
  <!-- Cards de Métricas -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 36px;">
    <div style="background: #FFF; padding: 20px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 16px;">
      <div style="width: 50px; height: 50px; background: #D1FAE5; color: #065F46; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
        <i class="fas fa-dollar-sign"></i>
      </div>
      <div>
        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Faturamento Total</span>
        <h3 style="font-size: 1.5rem; color: var(--primary); margin-top: 2px;"><%= formatMoney(totalRevenue) %></h3>
      </div>
    </div>

    <div style="background: #FFF; padding: 20px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 16px;">
      <div style="width: 50px; height: 50px; background: #DBEAFE; color: #1E40AF; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
        <i class="fas fa-shopping-bag"></i>
      </div>
      <div>
        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Total de Pedidos</span>
        <h3 style="font-size: 1.5rem; color: var(--text-dark); margin-top: 2px;"><%= totalOrders %></h3>
      </div>
    </div>

    <div style="background: #FFF; padding: 20px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 16px;">
      <div style="width: 50px; height: 50px; background: #FEF3C7; color: #92400E; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
        <i class="fas fa-boxes-stacked"></i>
      </div>
      <div>
        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Produtos</span>
        <h3 style="font-size: 1.5rem; color: var(--text-dark); margin-top: 2px;"><%= totalProducts %></h3>
      </div>
    </div>

    <div style="background: #FFF; padding: 20px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 16px;">
      <div style="width: 50px; height: 50px; background: #E0E7FF; color: #3730A3; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
        <i class="fas fa-users"></i>
      </div>
      <div>
        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Clientes</span>
        <h3 style="font-size: 1.5rem; color: var(--text-dark); margin-top: 2px;"><%= totalUsers %></h3>
      </div>
    </div>
  </div>

  <!-- Vendas Recentes -->
  <div style="background: #FFF; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); margin-bottom: 32px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h3 style="font-size: 1.2rem;">Últimos Pedidos Realizados</h3>
      <a href="/admin/dashboard?tab=pedidos" style="color: var(--secondary); font-weight: 700; font-size: 0.85rem;">Ver Todos os Pedidos <i class="fas fa-arrow-right"></i></a>
    </div>

    <% if (recentOrders && recentOrders.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Nº Pedido</th>
              <th>Cliente</th>
              <th>Pagamento</th>
              <th>Status do Pedido</th>
              <th>Total</th>
              <th>Data</th>
            </tr>
          </thead>
          <tbody>
            <% recentOrders.forEach(order => { %>
              <tr>
                <td><strong>#<%= order.orderNumber %></strong></td>
                <td><%= order.customerName %><br><span style="font-size: 0.78rem; color: var(--text-muted);"><%= order.customerEmail %></span></td>
                <td><span style="font-weight: 600;"><%= order.paymentMethod.toUpperCase() %></span> (<%= order.paymentStatus %>)</td>
                <td>
                  <span class="status-badge status-<%= order.orderStatus.toLowerCase().replace(/\s+/g, '-') %>">
                    <%= order.orderStatus %>
                  </span>
                </td>
                <td style="font-weight: 700; color: var(--primary);"><%= formatMoney(order.totalAmount) %></td>
                <td><%= new Date(order.createdAt).toLocaleDateString('pt-BR') %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p style="color: var(--text-muted); text-align: center; padding: 24px;">Nenhum pedido recente registrado.</p>
    <% } %>
  </div>
<% } %>

<!-- =================================================================== -->
<!-- ABA 2: GERENCIAMENTO DE PRODUTOS -->
<!-- =================================================================== -->
<% if (activeTab === 'produtos') { %>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h3 style="font-size: 1.3rem;">Catálogo de Produtos</h3>
    <a href="/admin/produtos/novo" class="btn btn-primary" style="padding: 10px 18px; font-size: 0.9rem;">
      <i class="fas fa-plus"></i> Novo Produto
    </a>
  </div>

  <div style="background: #FFF; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm);">
    <% if (products && products.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Foto</th>
              <th>Nome do Produto</th>
              <th>Categoria</th>
              <th>Artesão</th>
              <th>Preço</th>
              <th>Estoque</th>
              <th>Destaque</th>
              <th style="text-align: right;">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(prod => { %>
              <tr>
                <td>
                  <img src="<%= prod.images[0] %>" alt="<%= prod.name %>" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;">
                </td>
                <td>
                  <strong><%= prod.name %></strong>
                </td>
                <td><%= prod.category ? prod.category.name : '-' %></td>
                <td><span style="font-size: 0.85rem; font-weight: 600;"><%= prod.artisan %></span></td>
                <td style="font-weight: 700; color: var(--primary);"><%= formatMoney(prod.price) %></td>
                <td>
                  <span style="font-weight: 700; color: <%= prod.stock > 0 ? '#065F46' : '#991B1B' %>;">
                    <%= prod.stock %> un.
                  </span>
                </td>
                <td>
                  <% if (prod.featured) { %>
                    <span class="status-badge status-aprovado">Sim</span>
                  <% } else { %>
                    <span style="color: var(--text-light); font-size: 0.85rem;">Não</span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                  <div style="display: flex; gap: 8px; justify-content: flex-end; align-items: center;">
                    <a href="/admin/produtos/editar/<%= prod._id %>" class="btn btn-secondary" style="padding: 6px 14px; font-size: 0.85rem; font-weight: 700; background: #FFF9F3; border: 1px solid var(--secondary); color: var(--primary);" title="Editar Produto">
                      <i class="fas fa-pencil-alt"></i> Editar
                    </a>
                    <form action="/admin/produtos/excluir/<%= prod._id %>" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir este produto?');" style="display: inline;">
                      <button type="submit" class="btn" style="background: #FEE2E2; color: #991B1B; padding: 6px 12px; font-size: 0.82rem;" title="Excluir">
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p style="text-align: center; padding: 36px; color: var(--text-muted);">Nenhum produto cadastrado no catálogo.</p>
    <% } %>
  </div>
<% } %>

<!-- =================================================================== -->
<!-- ABA 3: CONTROLE DE PEDIDOS -->
<!-- =================================================================== -->
<% if (activeTab === 'pedidos') { %>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h3 style="font-size: 1.3rem;">Gestão de Pedidos e Vendas</h3>
  </div>

  <div style="background: #FFF; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm);">
    <% if (orders && orders.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Nº Pedido</th>
              <th>Cliente & Contato</th>
              <th>Endereço</th>
              <th>Pagamento</th>
              <th>Status Pedido</th>
              <th>Total</th>
              <th style="text-align: right;">Atualizar Status</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(order => { %>
              <tr>
                <td>
                  <strong>#<%= order.orderNumber %></strong><br>
                  <span style="font-size: 0.78rem; color: var(--text-muted);"><%= new Date(order.createdAt).toLocaleDateString('pt-BR') %></span>
                </td>
                <td>
                  <strong><%= order.customerName %></strong><br>
                  <span style="font-size: 0.8rem; color: var(--text-muted);"><%= order.customerEmail %></span><br>
                  <span style="font-size: 0.8rem; color: var(--secondary);"><%= order.customerPhone %></span>
                </td>
                <td>
                  <span style="font-size: 0.85rem;">
                    <%= order.shippingAddress.street %>, <%= order.shippingAddress.number %><br>
                    <%= order.shippingAddress.city %> / <%= order.shippingAddress.state %>
                  </span>
                </td>
                <td>
                  <span style="font-weight: 700; text-transform: uppercase;"><%= order.paymentMethod %></span><br>
                  <span class="status-badge status-<%= order.paymentStatus.toLowerCase() %>">
                    <%= order.paymentStatus %>
                  </span>
                </td>
                <td>
                  <span class="status-badge status-<%= order.orderStatus.toLowerCase().replace(/\s+/g, '-') %>">
                    <%= order.orderStatus %>
                  </span>
                </td>
                <td style="font-weight: 700; color: var(--primary);"><%= formatMoney(order.totalAmount) %></td>
                <td style="text-align: right;">
                  <form action="/admin/pedidos/status/<%= order._id %>" method="POST" style="display: flex; flex-direction: column; gap: 6px; align-items: flex-end;">
                    <select name="orderStatus" class="form-control" style="font-size: 0.8rem; padding: 4px 8px; width: 140px;">
                      <option value="Pendente" <%= order.orderStatus === 'Pendente' ? 'selected' : '' %>>Pendente</option>
                      <option value="Em Produção" <%= order.orderStatus === 'Em Produção' ? 'selected' : '' %>>Em Produção</option>
                      <option value="Enviado" <%= order.orderStatus === 'Enviado' ? 'selected' : '' %>>Enviado</option>
                      <option value="Entregue" <%= order.orderStatus === 'Entregue' ? 'selected' : '' %>>Entregue</option>
                      <option value="Cancelado" <%= order.orderStatus === 'Cancelado' ? 'selected' : '' %>>Cancelado</option>
                    </select>

                    <select name="paymentStatus" class="form-control" style="font-size: 0.8rem; padding: 4px 8px; width: 140px;">
                      <option value="Pendente" <%= order.paymentStatus === 'Pendente' ? 'selected' : '' %>>Pag. Pendente</option>
                      <option value="Aprovado" <%= order.paymentStatus === 'Aprovado' ? 'selected' : '' %>>Pag. Aprovado</option>
                      <option value="Recusado" <%= order.paymentStatus === 'Recusado' ? 'selected' : '' %>>Pag. Recusado</option>
                    </select>

                    <button type="submit" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.78rem;">Salvar</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p style="text-align: center; padding: 36px; color: var(--text-muted);">Nenhum pedido realizado até o momento.</p>
    <% } %>
  </div>
<% } %>

<!-- =================================================================== -->
<!-- ABA 4: USUÁRIOS E CLIENTES -->
<!-- =================================================================== -->
<% if (activeTab === 'usuarios') { %>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h3 style="font-size: 1.3rem;">Gestão de Usuários e Clientes Cadastrados</h3>
    <a href="/admin/usuarios/novo" class="btn btn-primary" style="padding: 10px 18px; font-size: 0.9rem;">
      <i class="fas fa-user-plus"></i> Adicionar Usuário / Cliente
    </a>
  </div>

  <div style="background: #FFF; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm);">
    <% if (users && users.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Nome</th>
              <th>E-mail</th>
              <th>Telefone</th>
              <th>Perfil</th>
              <th>Pedidos Feitos</th>
              <th>Data de Cadastro</th>
              <th style="text-align: right;">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr>
                <td>
                  <strong><%= u.name %></strong>
                </td>
                <td><%= u.email %></td>
                <td><%= u.phone || '-' %></td>
                <td>
                  <% if (u.role === 'admin') { %>
                    <span class="status-badge" style="background: #FEF3C7; color: #92400E;"><i class="fas fa-crown"></i> Admin</span>
                  <% } else { %>
                    <span class="status-badge status-aprovado">Cliente</span>
                  <% } %>
                </td>
                <td><strong style="color: var(--primary);"><%= u.orderCount %> pedido(s)</strong></td>
                <td><%= new Date(u.createdAt).toLocaleDateString('pt-BR') %></td>
                <td style="text-align: right;">
                  <div style="display: flex; gap: 8px; justify-content: flex-end; align-items: center;">
                    <a href="/admin/usuarios/editar/<%= u._id %>" class="btn btn-secondary" style="padding: 6px 14px; font-size: 0.85rem; font-weight: 700; background: #FFF9F3; border: 1px solid var(--secondary); color: var(--primary);" title="Editar Usuário">
                      <i class="fas fa-pencil-alt"></i> Editar
                    </a>
                    <% if (u._id.toString() !== locals.user._id.toString()) { %>
                      <form action="/admin/usuarios/excluir/<%= u._id %>" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir este usuário?');" style="display: inline;">
                        <button type="submit" class="btn" style="background: #FEE2E2; color: #991B1B; padding: 6px 12px; font-size: 0.82rem;" title="Excluir">
                          <i class="fas fa-trash-alt"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p style="text-align: center; padding: 36px; color: var(--text-muted);">Nenhum usuário cadastrado.</p>
    <% } %>
  </div>
<% } %>

<!-- =================================================================== -->
<!-- ABA 5: ARTESÃOS DA FAMÍLIA -->
<!-- =================================================================== -->
<% if (activeTab === 'artesaos') { %>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h3 style="font-size: 1.3rem;">Membros da Família & Artesãos</h3>
    <a href="/admin/artesaos/novo" class="btn btn-primary" style="padding: 10px 18px; font-size: 0.9rem;">
      <i class="fas fa-plus"></i> Adicionar Artesão
    </a>
  </div>

  <div style="background: #FFF; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm);">
    <% if (artisans && artisans.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Foto</th>
              <th>Nome</th>
              <th>Função</th>
              <th>Especialidade</th>
              <th>Resumo / Biografia</th>
              <th style="text-align: right;">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% artisans.forEach(art => { %>
              <tr>
                <td>
                  <img src="<%= art.avatar %>" alt="<%= art.name %>" style="width: 50px; height: 50px; object-fit: cover; border-radius: 50%; border: 2px solid var(--secondary);">
                </td>
                <td><strong><%= art.name %></strong></td>
                <td><span class="status-badge status-aprovado"><%= art.role %></span></td>
                <td><strong style="color: var(--primary);"><%= art.specialty %></strong></td>
                <td style="max-width: 300px; font-size: 0.88rem; color: var(--text-muted);"><%= art.bio %></td>
                <td style="text-align: right;">
                  <div style="display: flex; gap: 8px; justify-content: flex-end; align-items: center;">
                    <a href="/admin/artesaos/editar/<%= art._id %>" class="btn btn-secondary" style="padding: 6px 14px; font-size: 0.85rem; font-weight: 700; background: #FFF9F3; border: 1px solid var(--secondary); color: var(--primary);" title="Editar Artesão">
                      <i class="fas fa-pencil-alt"></i> Editar
                    </a>
                    <form action="/admin/artesaos/excluir/<%= art._id %>" method="POST" onsubmit="return confirm('Tem certeza que deseja remover este artesão?');" style="display: inline;">
                      <button type="submit" class="btn" style="background: #FEE2E2; color: #991B1B; padding: 6px 12px; font-size: 0.82rem;" title="Excluir">
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p style="text-align: center; padding: 36px; color: var(--text-muted);">Nenhum artesão cadastrado.</p>
    <% } %>
  </div>
<% } %>

<!-- =================================================================== -->
<!-- ABA 6: CATEGORIAS -->
<!-- =================================================================== -->
<% if (activeTab === 'categorias') { %>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h3 style="font-size: 1.3rem;">Categorias de Produtos</h3>
    <a href="/admin/categorias/novo" class="btn btn-primary" style="padding: 10px 18px; font-size: 0.9rem;">
      <i class="fas fa-plus"></i> Nova Categoria
    </a>
  </div>

  <div style="background: #FFF; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm);">
    <% if (categories && categories.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Capa</th>
              <th>Nome</th>
              <th>Slug / URL</th>
              <th>Ícone</th>
              <th>Descrição</th>
              <th style="text-align: right;">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% categories.forEach(cat => { %>
              <tr>
                <td>
                  <img src="<%= cat.image %>" alt="<%= cat.name %>" style="width: 60px; height: 40px; object-fit: cover; border-radius: 6px;">
                </td>
                <td><strong><%= cat.name %></strong></td>
                <td><code>/categoria/<%= cat.slug %></code></td>
                <td><i class="fas <%= cat.icon %>" style="font-size: 1.2rem; color: var(--secondary);"></i></td>
                <td style="font-size: 0.88rem; color: var(--text-muted);"><%= cat.description %></td>
                <td style="text-align: right;">
                  <div style="display: flex; gap: 8px; justify-content: flex-end; align-items: center;">
                    <a href="/admin/categorias/editar/<%= cat._id %>" class="btn btn-secondary" style="padding: 6px 14px; font-size: 0.85rem; font-weight: 700; background: #FFF9F3; border: 1px solid var(--secondary); color: var(--primary);" title="Editar Categoria">
                      <i class="fas fa-pencil-alt"></i> Editar
                    </a>
                    <form action="/admin/categorias/excluir/<%= cat._id %>" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir esta categoria?');" style="display: inline;">
                      <button type="submit" class="btn" style="background: #FEE2E2; color: #991B1B; padding: 6px 12px; font-size: 0.82rem;" title="Excluir">
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p style="text-align: center; padding: 36px; color: var(--text-muted);">Nenhuma categoria cadastrada.</p>
    <% } %>
  </div>
<% } %>

<!-- =================================================================== -->
<!-- ABA 7: DOCUMENTAÇÃO TÉCNICA COMPLETA -->
<!-- =================================================================== -->
<% if (activeTab === 'docs') { %>
  <div style="background: #FFF; padding: 32px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); margin-bottom: 40px;">
    
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 28px; border-bottom: 2px solid var(--border-light); padding-bottom: 20px;">
      <div>
        <h2 style="font-size: 1.8rem; color: var(--primary); display: flex; align-items: center; gap: 12px; margin-bottom: 6px;">
          <i class="fas fa-book-bookmark"></i> Documentação Técnica do Sistema
        </h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Guia completo de arquitetura, integrações, variáveis de ambiente e manutenção do e-commerce <strong>O Que É Isso?</strong></p>
      </div>
      <div>
        <span style="background: #D1FAE5; color: #065F46; padding: 6px 16px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 6px;">
          <i class="fas fa-circle-check"></i> Produção v1.0
        </span>
      </div>
    </div>

    <!-- Seção 1: Arquitetura & Stack -->
    <div style="margin-bottom: 40px;">
      <h3 style="font-size: 1.3rem; color: var(--primary); margin-bottom: 16px; display: flex; align-items: center; gap: 10px;">
        <i class="fas fa-layer-group" style="color: var(--accent);"></i> 1. Arquitetura do Sistema & Stack Tecnológica
      </h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
        <div style="background: #FDFBF7; padding: 20px; border-radius: 12px; border: 1px solid var(--border-light);">
          <div style="font-size: 1.4rem; color: var(--primary); margin-bottom: 8px;"><i class="fab fa-node-js"></i> Backend</div>
          <strong style="display: block; font-size: 1rem; margin-bottom: 4px;">Node.js v20 & Express</strong>
          <span style="font-size: 0.85rem; color: var(--text-muted);">Servidor RESTful com renderização de páginas EJS de alta performance.</span>
        </div>

        <div style="background: #FDFBF7; padding: 20px; border-radius: 12px; border: 1px solid var(--border-light);">
          <div style="font-size: 1.4rem; color: #059669; margin-bottom: 8px;"><i class="fas fa-database"></i> Banco de Dados</div>
          <strong style="display: block; font-size: 1rem; margin-bottom: 4px;">MongoDB v7.0 & Mongoose</strong>
          <span style="font-size: 0.85rem; color: var(--text-muted);">Container isolado com volume persistente <code>mongo_data</code> na VPS.</span>
        </div>

        <div style="background: #FDFBF7; padding: 20px; border-radius: 12px; border: 1px solid var(--border-light);">
          <div style="font-size: 1.4rem; color: #2563EB; margin-bottom: 8px;"><i class="fas fa-shield-halved"></i> Autenticação</div>
          <strong style="display: block; font-size: 1rem; margin-bottom: 4px;">Passport + Google OAuth</strong>
          <span style="font-size: 0.85rem; color: var(--text-muted);">Login por e-mail/senha com hash bcrypt e login social seguro do Google.</span>
        </div>

        <div style="background: #FDFBF7; padding: 20px; border-radius: 12px; border: 1px solid var(--border-light);">
          <div style="font-size: 1.4rem; color: #D97706; margin-bottom: 8px;"><i class="fas fa-credit-card"></i> Pagamentos</div>
          <strong style="display: block; font-size: 1rem; margin-bottom: 4px;">Mercado Pago & Webhook</strong>
          <span style="font-size: 0.85rem; color: var(--text-muted);">Pix transparente instantâneo com atualização automática de status.</span>
        </div>
      </div>
    </div>

    <!-- Seção 2: Variáveis de Ambiente -->
    <div style="margin-bottom: 40px;">
      <h3 style="font-size: 1.3rem; color: var(--primary); margin-bottom: 16px; display: flex; align-items: center; gap: 10px;">
        <i class="fas fa-key" style="color: var(--accent);"></i> 2. Variáveis de Ambiente (Arquivo <code>.env</code>)
      </h3>
      <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 16px;">O arquivo <code>.env</code> na VPS deve ficar localizado em <code>/opt/docker/oqueeisso/.env</code> com o seguinte modelo:</p>
      
      <div style="background: #1E1E1E; color: #D4D4D4; padding: 20px; border-radius: 12px; font-family: monospace; font-size: 0.88rem; overflow-x: auto; line-height: 1.6;">
<span style="color: #6A9955;"># Servidor & Banco de Dados</span>
NODE_ENV=production
PORT=80
MONGODB_URI=mongodb://mongo:27017/oqueeisso
JWT_SECRET=oqueeisso_super_secret_jwt_key_2026_artesanato

<span style="color: #6A9955;"># URLs Públicas da Aplicação em Produção</span>
BASE_URL=https://oqueeisso.com
WEBHOOK_URL=https://oqueeisso.com

<span style="color: #6A9955;"># Credenciais do Google OAuth 2.0</span>
GOOGLE_CLIENT_ID=<span style="color: #CE9178;">seu_client_id.apps.googleusercontent.com</span>
GOOGLE_CLIENT_SECRET=<span style="color: #CE9178;">seu_client_secret</span>
GOOGLE_CALLBACK_URL=https://oqueeisso.com/auth/google/callback

<span style="color: #6A9955;"># Credenciais do Mercado Pago</span>
MERCADOPAGO_ACCESS_TOKEN=<span style="color: #CE9178;">APP_USR-seu_access_token_aqui</span>

<span style="color: #6A9955;"># Serviço de E-mail SMTP (Hostinger)</span>
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=atendimento@oqueeisso.com
SMTP_PASS=<span style="color: #CE9178;">sua_senha_do_email_hostinger</span>
SMTP_FROM_NAME="O Que É Isso? Artesanato"
ADMIN_ALERT_EMAIL=atendimento@oqueeisso.com
      </div>
    </div>

    <!-- Seção 3: Guia de Integrações -->
    <div style="margin-bottom: 40px;">
      <h3 style="font-size: 1.3rem; color: var(--primary); margin-bottom: 16px; display: flex; align-items: center; gap: 10px;">
        <i class="fas fa-plug" style="color: var(--accent);"></i> 3. Integrações de Serviços Externos
      </h3>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <!-- Google OAuth -->
        <div style="background: #FDFBF7; padding: 20px; border-radius: 12px; border: 1px solid var(--border-light);">
          <h4 style="font-size: 1.1rem; color: var(--primary); margin-bottom: 10px; display: flex; align-items: center; gap: 8px;">
            <i class="fab fa-google" style="color: #EA4335;"></i> Google OAuth 2.0
          </h4>
          <ul style="font-size: 0.88rem; color: var(--text-color); padding-left: 18px; line-height: 1.6;">
            <li>Configurado via GCP Console em <strong>APIs e Serviços > Credenciais</strong>.</li>
            <li><strong>Origem Autorizada:</strong> <code>https://oqueeisso.com</code></li>
            <li><strong>URI de Redirecionamento:</strong> <code>https://oqueeisso.com/auth/google/callback</code></li>
            <li>Cria automaticamente o usuário com foto e e-mail verificado.</li>
          </ul>
        </div>

        <!-- Mercado Pago & Webhook -->
        <div style="background: #FDFBF7; padding: 20px; border-radius: 12px; border: 1px solid var(--border-light);">
          <h4 style="font-size: 1.1rem; color: var(--primary); margin-bottom: 10px; display: flex; align-items: center; gap: 8px;">
            <i class="fas fa-wallet" style="color: #009EE3;"></i> Mercado Pago & Webhook
          </h4>
          <ul style="font-size: 0.88rem; color: var(--text-color); padding-left: 18px; line-height: 1.6;">
            <li><strong>Geração do Pix:</strong> Códigos Pix copia-e-cola e QR Code nativos.</li>
            <li><strong>Rota Webhook:</strong> <code>POST /api/payments/webhook</code></li>
            <li>Quando o pagamento é aprovado, o pedido muda o status para <strong>"Aprovado"</strong> ou <strong>"Em Produção"</strong> sem intervenção manual.</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Seção 4: E-mails Automáticos -->
    <div style="margin-bottom: 40px;">
      <h3 style="font-size: 1.3rem; color: var(--primary); margin-bottom: 16px; display: flex; align-items: center; gap: 10px;">
        <i class="fas fa-envelope-open-text" style="color: var(--accent);"></i> 4. Notificações por E-mail (Hostinger SMTP)
      </h3>
      <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 12px;">Todos os e-mails são estilizados em HTML responsivo com a marca <strong>O Que É Isso?</strong> e enviados pelo remetente <code>atendimento@oqueeisso.com</code>:</p>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px;">
        <div style="background: #FFF; padding: 14px; border-radius: 8px; border: 1px solid var(--border-light); font-size: 0.88rem;">
          <strong style="color: var(--primary);"><i class="fas fa-user-plus"></i> Boas-vindas:</strong> Enviado ao cliente ao se cadastrar.
        </div>
        <div style="background: #FFF; padding: 14px; border-radius: 8px; border: 1px solid var(--border-light); font-size: 0.88rem;">
          <strong style="color: var(--primary);"><i class="fas fa-bell"></i> Novo Usuário:</strong> Alerta administrativo enviado para o admin.
        </div>
        <div style="background: #FFF; padding: 14px; border-radius: 8px; border: 1px solid var(--border-light); font-size: 0.88rem;">
          <strong style="color: var(--primary);"><i class="fas fa-shopping-cart"></i> Novo Pedido:</strong> Confirmação do pedido com resumo e Pix para o cliente.
        </div>
        <div style="background: #FFF; padding: 14px; border-radius: 8px; border: 1px solid var(--border-light); font-size: 0.88rem;">
          <strong style="color: var(--primary);"><i class="fas fa-check-double"></i> Pagamento Aprovado:</strong> Confirmação enviada após alteração no webhook.
        </div>
        <div style="background: #FFF; padding: 14px; border-radius: 8px; border: 1px solid var(--border-light); font-size: 0.88rem;">
          <strong style="color: var(--primary);"><i class="fas fa-truck"></i> Atualização de Status:</strong> Notifica o cliente se o pedido for Enviado ou Entregue.
        </div>
        <div style="background: #FFF; padding: 14px; border-radius: 8px; border: 1px solid var(--border-light); font-size: 0.88rem;">
          <strong style="color: var(--primary);"><i class="fas fa-headset"></i> Formulário de Contato:</strong> Mensagem da página <code>/contato</code> enviada ao atendimento.
        </div>
      </div>
    </div>

    <!-- Seção 5: PWA & Celular -->
    <div style="margin-bottom: 40px;">
      <h3 style="font-size: 1.3rem; color: var(--primary); margin-bottom: 16px; display: flex; align-items: center; gap: 10px;">
        <i class="fas fa-mobile-screen-button" style="color: var(--accent);"></i> 5. PWA (Progressive Web App - Aplicativo Mobile)
      </h3>
      <div style="background: #FDFBF7; padding: 20px; border-radius: 12px; border: 1px solid var(--border-light); display: flex; gap: 20px; align-items: center; flex-wrap: wrap;">
