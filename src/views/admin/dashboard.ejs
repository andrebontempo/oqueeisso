<%- include('../partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
  <div>
    <h1 style="font-size: 2.2rem; margin-bottom: 4px;">Painel de Controle Admin</h1>
    <p style="color: var(--text-muted);">Gerenciamento do e-commerce O Que É Isso? Artesanato</p>
  </div>
  <div style="display: flex; gap: 12px;">
    <a href="/admin/produtos/novo" class="btn btn-primary">
      <i class="fas fa-plus"></i> Novo Produto
    </a>
    <a href="/admin/pedidos" class="btn btn-secondary">
      <i class="fas fa-list-check"></i> Ver Pedidos
    </a>
  </div>
</div>

<!-- Cards de Estatísticas -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; margin-bottom: 40px;">
  
  <div style="background: #FFF; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 20px;">
    <div style="width: 56px; height: 56px; background: #D1FAE5; color: #065F46; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem;">
      <i class="fas fa-dollar-sign"></i>
    </div>
    <div>
      <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Faturamento Total</span>
      <h3 style="font-size: 1.6rem; color: var(--primary); margin-top: 2px;"><%= formatMoney(totalRevenue) %></h3>
    </div>
  </div>

  <div style="background: #FFF; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 20px;">
    <div style="width: 56px; height: 56px; background: #DBEAFE; color: #1E40AF; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem;">
      <i class="fas fa-shopping-bag"></i>
    </div>
    <div>
      <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Total de Pedidos</span>
      <h3 style="font-size: 1.6rem; color: var(--text-dark); margin-top: 2px;"><%= totalOrders %></h3>
    </div>
  </div>

  <div style="background: #FFF; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 20px;">
    <div style="width: 56px; height: 56px; background: #FEF3C7; color: #92400E; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem;">
      <i class="fas fa-boxes-stacked"></i>
    </div>
    <div>
      <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Produtos Ativos</span>
      <h3 style="font-size: 1.6rem; color: var(--text-dark); margin-top: 2px;"><%= totalProducts %></h3>
    </div>
  </div>

  <div style="background: #FFF; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 20px;">
    <div style="width: 56px; height: 56px; background: #E0E7FF; color: #3730A3; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem;">
      <i class="fas fa-users"></i>
    </div>
    <div>
      <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Clientes Cadastrados</span>
      <h3 style="font-size: 1.6rem; color: var(--text-dark); margin-top: 2px;"><%= totalUsers %></h3>
    </div>
  </div>

</div>

<!-- Pedidos Recentes -->
<div style="background: #FFF; padding: 28px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); margin-bottom: 40px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h3 style="font-size: 1.3rem;">Pedidos Recentes</h3>
    <a href="/admin/pedidos" style="color: var(--secondary); font-weight: 700; font-size: 0.9rem;">Ver Todos os Pedidos <i class="fas fa-arrow-right"></i></a>
  </div>

  <% if (recentOrders && recentOrders.length > 0) { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Nº Pedido</th>
            <th>Cliente</th>
            <th>Pagamento</th>
            <th>Status Pedido</th>
            <th>Total</th>
            <th>Data</th>
          </tr>
        </thead>
        <tbody>
          <% recentOrders.forEach(order => { %>
            <tr>
              <td><strong>#<%= order.orderNumber %></strong></td>
              <td><%= order.customerName %><br><span style="font-size: 0.78rem; color: var(--text-muted);"><%= order.customerEmail %></span></td>
              <td><span style="font-weight: 600;"><%= order.paymentMethod.toUpperCase() %></span> (<%= order.paymentStatus %>)</td>
              <td>
                <span class="status-badge status-<%= order.orderStatus.toLowerCase().replace(/\s+/g, '-') %>">
                  <%= order.orderStatus %>
                </span>
              </td>
              <td style="font-weight: 700; color: var(--primary);"><%= formatMoney(order.totalAmount) %></td>
              <td><%= new Date(order.createdAt).toLocaleDateString('pt-BR') %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p style="color: var(--text-muted); text-align: center; padding: 24px;">Nenhum pedido recente registrado.</p>
  <% } %>
</div>

<%- include('../partials/footer') %>
