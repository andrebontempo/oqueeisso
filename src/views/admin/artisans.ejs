<%- include('../partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
  <div>
    <h1 style="font-size: 2.2rem; margin-bottom: 4px;">Gerenciar Artesãos da Família</h1>
    <p style="color: var(--text-muted);">Cadastre, edite ou remova os membros da família e suas especialidades</p>
  </div>
  <a href="/admin/artesaos/novo" class="btn btn-primary">
    <i class="fas fa-user-plus"></i> Adicionar Artesão
  </a>
</div>

<% if (success) { %>
  <div class="alert alert-success">
    <i class="fas fa-check-circle"></i> <%= success %>
  </div>
<% } %>

<div style="background: #FFF; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm);">
  <% if (artisans && artisans.length > 0) { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Foto</th>
            <th>Nome</th>
            <th>Vínculo / Função</th>
            <th>Especialidade</th>
            <th>Resumo / Bio</th>
            <th style="text-align: right;">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% artisans.forEach(artisan => { %>
            <tr>
              <td>
                <img src="<%= artisan.avatar %>" alt="<%= artisan.name %>" style="width: 54px; height: 54px; object-fit: cover; border-radius: 50%; border: 2px solid var(--secondary);">
              </td>
              <td>
                <strong style="font-size: 1.05rem;"><%= artisan.name %></strong>
              </td>
              <td>
                <span class="status-badge status-aprovado"><%= artisan.role %></span>
              </td>
              <td><span style="font-weight: 600; color: var(--primary);"><%= artisan.specialty %></span></td>
              <td style="max-width: 320px; font-size: 0.88rem; color: var(--text-muted);"><%= artisan.bio %></td>
              <td style="text-align: right;">
                <div style="display: flex; gap: 8px; justify-content: flex-end;">
                  <a href="/admin/artesaos/editar/<%= artisan._id %>" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.82rem;" title="Editar">
                    <i class="fas fa-edit"></i>
                  </a>
                  <form action="/admin/artesaos/excluir/<%= artisan._id %>" method="POST" onsubmit="return confirm('Tem certeza que deseja remover este artesão?');" style="display: inline;">
                    <button type="submit" class="btn" style="background: #FEE2E2; color: #991B1B; padding: 6px 12px; font-size: 0.82rem;" title="Excluir">
                      <i class="fas fa-trash-alt"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div style="text-align: center; padding: 48px; color: var(--text-muted);">
      <i class="fas fa-user-gear" style="font-size: 3rem; color: var(--border-active); margin-bottom: 16px;"></i>
      <h3>Nenhum artesão cadastrado</h3>
      <p style="margin-bottom: 20px;">Cadastre os membros da família para exibi-los na página principal!</p>
      <a href="/admin/artesaos/novo" class="btn btn-primary">Cadastrar Primeiro Artesão</a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
