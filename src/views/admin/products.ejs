<%- include('../partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
  <div>
    <h1 style="font-size: 2.2rem; margin-bottom: 4px;">Gerenciar Produtos</h1>
    <p style="color: var(--text-muted);">Listagem completa das peças de artesanato do catálogo</p>
  </div>
  <a href="/admin/produtos/novo" class="btn btn-primary">
    <i class="fas fa-plus"></i> Adicionar Produto
  </a>
</div>

<% if (success) { %>
  <div class="alert alert-success">
    <i class="fas fa-check-circle"></i> <%= success %>
  </div>
<% } %>

<div style="background: #FFF; padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm);">
  <% if (products && products.length > 0) { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Imagem</th>
            <th>Nome do Produto</th>
            <th>Categoria</th>
            <th>Artesão</th>
            <th>Preço</th>
            <th>Estoque</th>
            <th>Destaque</th>
            <th style="text-align: right;">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(prod => { %>
            <tr>
              <td>
                <img src="<%= prod.images[0] %>" alt="<%= prod.name %>" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;">
              </td>
              <td>
                <strong><%= prod.name %></strong>
              </td>
              <td><%= prod.category ? prod.category.name : '-' %></td>
              <td><span style="font-size: 0.85rem; font-weight: 600;"><%= prod.artisan %></span></td>
              <td style="font-weight: 700; color: var(--primary);"><%= formatMoney(prod.price) %></td>
              <td>
                <span style="font-weight: 700; color: <%= prod.stock > 0 ? '#065F46' : '#991B1B' %>;">
                  <%= prod.stock %> un.
                </span>
              </td>
              <td>
                <% if (prod.featured) { %>
                  <span class="status-badge status-aprovado">Sim</span>
                <% } else { %>
                  <span style="color: var(--text-light); font-size: 0.85rem;">Não</span>
                <% } %>
              </td>
              <td style="text-align: right;">
                <div style="display: flex; gap: 8px; justify-content: flex-end;">
                  <a href="/admin/produtos/editar/<%= prod._id %>" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.82rem;" title="Editar">
                    <i class="fas fa-edit"></i>
                  </a>
                  <form action="/admin/produtos/excluir/<%= prod._id %>" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir este produto?');" style="display: inline;">
                    <button type="submit" class="btn" style="background: #FEE2E2; color: #991B1B; padding: 6px 12px; font-size: 0.82rem;" title="Excluir">
                      <i class="fas fa-trash-alt"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p style="text-align: center; padding: 36px; color: var(--text-muted);">Nenhum produto cadastrado no catálogo.</p>
  <% } %>
</div>

<%- include('../partials/footer') %>
