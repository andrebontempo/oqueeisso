<%- include('../partials/header') %>

<div style="margin-bottom: 24px;">
  <a href="/admin/dashboard?tab=usuarios" style="color: var(--text-muted); font-size: 0.9rem;">
    <i class="fas fa-arrow-left"></i> Voltar para Lista de Usuários
  </a>
</div>

<div style="max-width: 760px; margin: 0 auto; background: #FFF; padding: 36px; border-radius: var(--radius-lg); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); margin-bottom: 48px;">
  
  <h1 style="font-size: 2rem; margin-bottom: 8px;"><%= userForm && userForm._id ? 'Editar Usuário / Cliente' : 'Cadastrar Novo Usuário / Cliente' %></h1>
  <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 24px;">Gerencie os dados de acesso, perfil de permissão (Cliente vs Admin) e endereço.</p>

  <% if (error) { %>
    <div class="alert alert-danger">
      <i class="fas fa-exclamation-triangle"></i> <%= error %>
    </div>
  <% } %>

  <form action="<%= userForm && userForm._id ? '/admin/usuarios/editar/' + userForm._id : '/admin/usuarios/novo' %>" method="POST">
    
    <div class="form-group">
      <label class="form-label">Nome Completo *</label>
      <input type="text" name="name" class="form-control" required value="<%= userForm ? userForm.name : '' %>" placeholder="Ex: Maria das Dores">
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
      <div class="form-group">
        <label class="form-label">E-mail *</label>
        <input type="email" name="email" class="form-control" required value="<%= userForm ? userForm.email : '' %>" placeholder="maria@email.com">
      </div>

      <div class="form-group">
        <label class="form-label">Perfil / Permissão *</label>
        <select name="role" class="form-control" required>
          <option value="user" <%= userForm && userForm.role === 'user' ? 'selected' : '' %>>Cliente (Comprador)</option>
          <option value="admin" <%= userForm && userForm.role === 'admin' ? 'selected' : '' %>>Administrador (Acesso Total)</option>
        </select>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
      <div class="form-group">
        <label class="form-label">Senha <%= userForm && userForm._id ? '(Deixe em branco para manter a atual)' : '*' %></label>
        <input type="password" name="password" class="form-control" <%= userForm && userForm._id ? '' : 'required' %> placeholder="Mínimo 6 caracteres">
      </div>

      <div class="form-group">
        <label class="form-label">Telefone / WhatsApp</label>
        <input type="tel" name="phone" class="form-control" value="<%= userForm ? userForm.phone : '' %>" placeholder="(11) 99999-9999">
      </div>
    </div>

    <h3 style="font-size: 1.1rem; margin: 24px 0 16px; color: var(--primary); border-bottom: 1px solid var(--border-light); padding-bottom: 8px;">
      Endereço do Usuário
    </h3>

    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 16px;">
      <div class="form-group">
        <label class="form-label">CEP</label>
        <input type="text" name="zipCode" class="form-control" value="<%= userForm && userForm.address ? userForm.address.zipCode : '' %>" placeholder="00000-000">
      </div>
      <div class="form-group">
        <label class="form-label">Rua / Logradouro</label>
        <input type="text" name="street" class="form-control" value="<%= userForm && userForm.address ? userForm.address.street : '' %>" placeholder="Rua das Flores">
      </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 16px;">
      <div class="form-group">
        <label class="form-label">Número</label>
        <input type="text" name="number" class="form-control" value="<%= userForm && userForm.address ? userForm.address.number : '' %>" placeholder="123">
      </div>
      <div class="form-group">
        <label class="form-label">Bairro</label>
        <input type="text" name="neighborhood" class="form-control" value="<%= userForm && userForm.address ? userForm.address.neighborhood : '' %>" placeholder="Centro">
      </div>
    </div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px;">
      <div class="form-group">
        <label class="form-label">Cidade</label>
        <input type="text" name="city" class="form-control" value="<%= userForm && userForm.address ? userForm.address.city : '' %>" placeholder="São Paulo">
      </div>
      <div class="form-group">
        <label class="form-label">Estado (UF)</label>
        <input type="text" name="state" class="form-control" maxlength="2" value="<%= userForm && userForm.address ? userForm.address.state : 'SP' %>">
      </div>
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 14px; font-size: 1.05rem; margin-top: 12px;">
      <i class="fas fa-save"></i> <%= userForm && userForm._id ? 'Salvar Alterações' : 'Cadastrar Usuário' %>
    </button>
  </form>

</div>

<%- include('../partials/footer') %>
